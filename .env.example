# Copy this file to .env and paste your real values.

APP_NAME=FlowCore AI Automation MVP
ENVIRONMENT=development
API_HOST=0.0.0.0
API_PORT=8000
PUBLIC_BASE_URL=
LOG_LEVEL=INFO
AUTOMATION_SECRET=change-this-long-random-secret

# Recommended production format:
# DATABASE_URL=postgresql+psycopg://postgres:password@host:5432/FlowCore
DATABASE_URL=sqlite:///./FlowCore.sqlite3

OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_SITE_URL=https://flowcore.example
OPENROUTER_APP_NAME=FlowCore

# Use cloudinary for Instagram publishing because Meta needs a public video URL.
STORAGE_PROVIDER=cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=flowcore/reels

# Free media sources
PEXELS_API_KEY=
PIXABAY_API_KEY=

# Meme template source: Imgflip uses account username/password, not an API key.
MEME_TEMPLATE_PROVIDER=imgflip
ENABLE_IMGFLIP_MEMES=true
IMGFLIP_USERNAME=
IMGFLIP_PASSWORD=
IMGFLIP_TEMPLATE_IDS=181913649,112126428,87743020,97984,102156234,61579,101470,27813981
IMGFLIP_FONT=impact
IMGFLIP_MAX_FONT_SIZE=50

# Free voiceover
TTS_PROVIDER=edge
EDGE_TTS_VOICE=en-IN-PrabhatNeural
EDGE_TTS_RATE=+0%
EDGE_TTS_VOLUME=+0%
SAPI_TTS_VOICE=Microsoft Zira Desktop
SAPI_TTS_RATE=1

# Local music and sound effects
MUSIC_DIR=assets/music
SFX_DIR=assets/sfx
ENABLE_BACKGROUND_MUSIC=true
BACKGROUND_MUSIC_VOLUME=0.18
VOICEOVER_VOLUME=1.0

META_GRAPH_VERSION=v25.0
META_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=
AUTO_PUBLISH_INSTAGRAM=false

FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
AUTO_PUBLISH_FACEBOOK=false

DEFAULT_BUSINESS_NAME=ServiZephyr Restaurant
DEFAULT_NICHE=restaurant management software for restaurants cafes dhabas QSRs cloud kitchens and local food businesses
DEFAULT_TARGET_AUDIENCE=restaurant owners cafe owners dhaba owners QSR operators cloud kitchen owners managers cashiers waiters and chefs
DEFAULT_BRAND_TONE=funny relatable Hinglish practical confident
DEFAULT_CTA=DM us the word RESTAURANT
DEFAULT_CONTENT_MODE=carousel
PRODUCT_NAME=ServiZephyr Restaurant

VIDEO_WIDTH=1080
VIDEO_HEIGHT=1920
VIDEO_FPS=30
VIDEO_SCENE_SECONDS=4
VIDEO_BACKGROUND_COLOR=#111827
VIDEO_ACCENT_COLOR=#22c55e
FFMPEG_BINARY=ffmpeg

# Keep true until you are ready to publish real reels.
DRY_RUN_PUBLISH=true
ENABLE_MEME_VOICEOVER=false
ENABLE_GENERATED_MUSIC=true
MEME_FRAME_SECONDS=3
MEME_STORY_FRAMES=4
BRAND_LOGO_PATH=assets/brand/logo.png
